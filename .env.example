# Names only, never values (R3). DATABASE_URL arrives with SIM-002.
PORT=

# Postgres connection string (set in .env.local; never commit a value)
DATABASE_URL=

# Local dev token (SIM-028)
# Token file path; default ~/.config/simap/dev-token
SIMAP_DEV_TOKEN_FILE=
# Email for pnpm dev:token (skips the prompt)
SIMAP_DEV_EMAIL=
# Org uuid for pnpm dev:token (or --org)
SIMAP_DEV_ORG=
# Set by scripts/dev.mjs only; never set it in a .env file
NEXT_PUBLIC_SIMAP_DEV_TOKEN=
# dev:prod and dev-script guards (SIM-029): names only
SIMAP_DB_TARGET=
SIMAP_PROD_TUNNEL_PORT=
SIMAP_PG_TUNNEL=

# Set by scripts/dev-prod.mjs only (red "Production data" badge); never set it in a .env file.
# NEXT_PUBLIC_SIMAP_DEV_PROD=

# Google Drive for device-type images (D61): set all four or none (none = images off). Scope drive.file (M-46).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_FOLDER_ID=

# NEXT_PUBLIC_SIMAP_VERSION=  (set only by the Docker build from the release tag; unset shows "dev")

# App-scope Identity role for mmlabs super admins (D86); unset = feature off
SIMAP_SUPER_ADMIN_ROLE=
