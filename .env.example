# Names only, never values (R3). DATABASE_URL arrives with SIM-002.
PORT=

# Postgres connection string (set in .env.local; never commit a value)
DATABASE_URL=

# Local dev token (SIM-028)
# Token file path; default ~/.config/simap/dev-token
SIMAP_DEV_TOKEN_FILE=
# Email for pnpm dev:token (skips the prompt)
SIMAP_DEV_EMAIL=
# Org uuid for pnpm dev:token (or --org)
SIMAP_DEV_ORG=
# Set by scripts/dev.mjs only; never set it in a .env file
NEXT_PUBLIC_SIMAP_DEV_TOKEN=
