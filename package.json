{
  "name": "simap",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "check:layers": "node scripts/check-layers.mjs",
    "migrate": "node --env-file-if-exists=.env.local db/migrate.js",
    "migrate:smoke": "node --env-file-if-exists=.env.local scripts/migrate-smoke.mjs",
    "schema:check": "node --env-file-if-exists=.env.local scripts/schema-check.mjs",
    "seed:dev": "node --env-file-if-exists=.env.local db/seed-dev.js"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.34.9"
}
